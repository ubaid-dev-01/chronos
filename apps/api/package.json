{
  "name": "@chronos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && tsx watch --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format cjs",
    "start": "node api.js && node dist/index.js",
    "seed:superadmin": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first tsx --env-file=.env ../../packages/db/scripts/seed-superadmin.ts",
    "lint": "echo 'no lint configured yet'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@chronos/db": "workspace:*",
    "@chronos/types": "workspace:*",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.0",
    "stripe": "^17.5.0",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "supertest": "^7.2.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
