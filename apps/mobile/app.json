{
  "expo": {
    "name": "Chronos",
    "slug": "chronos-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chronos",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
