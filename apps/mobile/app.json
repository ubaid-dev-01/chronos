      "bundleIdentifier": "app.chronos.mobile"
    },
    "android": {
      "package": "app.chronos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      }
    },
    "extra": {
      "apiUrl": "http://localhost:4000/v1"
    }
  }
}
