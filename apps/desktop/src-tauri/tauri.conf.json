{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Chronos",
  "version": "0.1.0",
  "identifier": "com.chronos.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chronos",
        "width": 400,
        "height": 680,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": true
      },
      {
        "label": "timer",
        "title": "Chronos Timer",
        "url": "index.html?view=timer",
        "width": 280,
        "height": 110,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Chronos - Time Tracker"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:4000 https://api.chronos.app wss://api.chronos.app http://localhost:3000; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright 2026 Chronos",
    "shortDescription": "Privacy-first time tracking",
    "longDescription": "Chronos desktop agent tracks time on assigned tasks with on-device screenshot blur and automatic sync.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null,
      "exceptionDomain": ""
    }
  }
}
