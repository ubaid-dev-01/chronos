# =========================
# JWT Authentication
# =========================
JWT_ACCESS_SECRET=replace-with-long-random-secret-min-32-chars

# =========================
# MongoDB
# =========================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/chronos?retryWrites=true&w=majority

# =========================
# Stripe Billing
# =========================
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# =========================
# AWS S3 Screenshots (production)
# Leave AWS_ACCESS_KEY_ID empty to use local disk storage in apps/api/uploads/
# =========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=chronos-screenshots
AWS_REGION=us-east-1

# =========================
# Email (invite automation)
# Prefer Resend. If RESEND_API_KEY is set, SMTP is ignored.
# Testing from: Chronos <onboarding@resend.dev>
# Production: verify your domain in Resend, then use noreply@yourdomain.com
# =========================
RESEND_API_KEY=
EMAIL_FROM=Chronos <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# App URLs
# Clients accept either http://localhost:4000 or http://localhost:4000/v1
# (trailing /v1 is stripped so fetches are never doubled).
# =========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# =========================
# Desktop / mobile download URLs (production)
# =========================
DOWNLOAD_BASE_URL=https://github.com/your-org/chronos/releases/latest/download
DOWNLOAD_URL_WINDOWS=
DOWNLOAD_URL_MACOS=
DOWNLOAD_URL_LINUX=
DESKTOP_AGENT_VERSION=0.1.0
MOBILE_IOS_URL=
MOBILE_ANDROID_URL=

# =========================
# Platform Superadmin
# =========================
SUPERADMIN_EMAIL=admin@chronos.app
SUPERADMIN_PASSWORD=change-me-min-8-chars
SUPERADMIN_SESSION_SECRET=replace-with-long-random-secret-min-32-chars
